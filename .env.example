# =============================================================
# Required – Document Routing Agent
# =============================================================

# Microsoft Entra (app-only, used for SharePoint + Graph email)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# SharePoint
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/YourSite
SHAREPOINT_FOLDER_SERVER_RELATIVE=/sites/YourSite/Shared Documents

# Graph email sender mailbox UPN
GRAPH_SENDER_UPN=automation@contoso.com

# Google Drive
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# =============================================================
# Optional – Purview catalog metadata lookup
# =============================================================
PURVIEW_ENDPOINT=

# =============================================================
# Optional – Outbound domain policy (label-based blocking)
# =============================================================
ALLOWED_RECIPIENT_DOMAINS=contoso.com
BLOCKED_PURVIEW_LABELS=confidential,secret,restricted

# =============================================================
# Optional – Purview DLP middleware enforcement
# Mirrors the microsoft/agent-framework purview_agent sample.
# Set ENABLE_PURVIEW_POLICY_ENFORCEMENT=true to activate.
# =============================================================

# Enable Purview DLP policy checks before every email send
ENABLE_PURVIEW_POLICY_ENFORCEMENT=false

# Entra user object-ID GUID to use for policy evaluation
# (find it in Entra admin center > Users > your user > Object ID)
PURVIEW_DEFAULT_USER_ID=

# App name shown in Purview audit logs
PURVIEW_APP_NAME=DocumentRoutingAgent

# If true, Purview errors are logged but do not block the send
PURVIEW_IGNORE_EXCEPTIONS=false

# If true, 402 Payment Required from Purview is ignored
PURVIEW_IGNORE_PAYMENT_REQUIRED=false

# Entra app client ID for Purview credential (can be same as ENTRA_CLIENT_ID)
# For interactive browser auth: needs delegated Graph Purview permissions
PURVIEW_CLIENT_APP_ID=your-entra-client-id-for-purview

# Auth mode for Purview – set to true for certificate (headless/CI/prod)
PURVIEW_USE_CERT_AUTH=false

# Required when PURVIEW_USE_CERT_AUTH=true
PURVIEW_TENANT_ID=
PURVIEW_CERT_PATH=
PURVIEW_CERT_PASSWORD=

# =============================================================
# Optional – Azure AI Foundry (for purview_test.py scenarios)
# =============================================================
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-4o-mini

# =============================================================
# Optional – Agent 365 observability
# =============================================================
ENABLE_A365_OBSERVABILITY=true
OBSERVABILITY_SERVICE_NAME=DocumentRoutingAgent
OBSERVABILITY_SERVICE_NAMESPACE=GCPAgent

# =============================================================
# Optional – Unattended DLP incident-alert creation
# Used by scripts/Create-DlpPolicyForCustomAIApps.ps1 -NonInteractive
# and by the weekly GitHub Actions workflow
# (.github/workflows/weekly-incident-alerts.yml).
# In GitHub, set these as Actions secrets/variables instead of in .env.
# =============================================================
PURVIEW_DLP_TARGET_APP_ID=
PURVIEW_DLP_CONNECT_APP_ID=
PURVIEW_DLP_CERT_BASE64=
PURVIEW_DLP_CERT_PASSWORD=
PURVIEW_DLP_ORGANIZATION=
PURVIEW_DLP_POLICY_NAME=
PURVIEW_DLP_RULE_NAME=
PURVIEW_DLP_APP_DISPLAY_NAME=
PURVIEW_DLP_POLICY_MODE=
PURVIEW_DLP_RESTRICT_ACTION=
PURVIEW_DLP_ALERT_RECIPIENTS=
PURVIEW_DLP_INCIDENT_RECIPIENTS=
PURVIEW_DLP_NOTIFY_RECIPIENTS=
PURVIEW_DLP_REPORT_SEVERITY=
